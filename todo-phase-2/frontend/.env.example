# Database (same as backend)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth (shared with backend - MUST match exactly)
BETTER_AUTH_SECRET=your-256-bit-secret-here

# Backend API URL (Hugging Face Space URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth URL (your frontend URL - used for baseURL and trustedOrigins)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Public App URL (optional - for additional trusted origins)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
