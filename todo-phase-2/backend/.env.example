# ===========================================
# HUGGING FACE DEPLOYMENT ENVIRONMENT VARIABLES
# ===========================================

# --------------------------------------------
# DATABASE (from Neon dashboard)
# --------------------------------------------
# Format: postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Example: postgresql://neondb_owner:abc123xyz@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------
# AUTH (MUST match frontend BETTER_AUTH_SECRET exactly!)
# --------------------------------------------
# Generate with: openssl rand -base64 32
# Example: K7gN2xQ9mP4wL8vR3yT6uJ1sF5hB0cD7eA2iO9nM4kX=
BETTER_AUTH_SECRET=your-256-bit-secret-here

# --------------------------------------------
# SERVER
# --------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --------------------------------------------
# EMAIL CONFIGURATION (Resend API - Simple & Free)
# --------------------------------------------
# Setup:
# 1. Sign up at https://resend.com (free - 100 emails/day, 3000/month)
# 2. Get your API key from the dashboard
# 3. Paste it below and set EMAIL_ENABLED=true
# 4. That's it! No domain verification needed for testing (uses onboarding@resend.dev)
#
# Example: re_abc123xyz...

EMAIL_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=DoneKaro <onboarding@resend.dev>

# --------------------------------------------
# NOTIFICATION SETTINGS
# --------------------------------------------
# Hours before deadline to send reminder email
DEADLINE_REMINDER_HOURS=24
# Enable/disable the background scheduler
SCHEDULER_ENABLED=true

# --------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM) - Push Notifications
# --------------------------------------------
# To enable FCM:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key" to download JSON file
# 3. Copy the ENTIRE JSON content (minified) as a single line below
# Example: {"type":"service_account","project_id":"your-project",...}
FCM_CREDENTIALS_JSON=
# Enable/disable FCM push notifications
FCM_ENABLED=true

# --------------------------------------------
# AI CHATBOT (LiteLLM + Google Gemini)
# --------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model to use (options: gemini/gemini-2.5-flash, gemini/gemini-2.5-flash-lite, gpt-4o-mini)
LLM_MODEL=gemini/gemini-2.5-flash
# Enable/disable chatbot feature
CHATBOT_ENABLED=true
