# Database (from Neon dashboard)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth (shared with frontend - MUST match exactly)
BETTER_AUTH_SECRET=your-256-bit-secret-here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Email Configuration (SMTP)
# Set EMAIL_ENABLED=true to enable email sending
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Todo App

# Notification Settings
# Hours before deadline to send reminder email
DEADLINE_REMINDER_HOURS=24
# Enable/disable the background scheduler
SCHEDULER_ENABLED=true
