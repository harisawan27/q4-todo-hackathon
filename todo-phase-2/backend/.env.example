# ===========================================
# HUGGING FACE DEPLOYMENT ENVIRONMENT VARIABLES
# ===========================================

# --------------------------------------------
# DATABASE (from Neon dashboard)
# --------------------------------------------
# Format: postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Example: postgresql://neondb_owner:abc123xyz@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------
# AUTH (MUST match frontend BETTER_AUTH_SECRET exactly!)
# --------------------------------------------
# Generate with: openssl rand -base64 32
# Example: K7gN2xQ9mP4wL8vR3yT6uJ1sF5hB0cD7eA2iO9nM4kX=
BETTER_AUTH_SECRET=your-256-bit-secret-here

# --------------------------------------------
# SERVER
# --------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --------------------------------------------
# EMAIL CONFIGURATION (Gmail SMTP)
# --------------------------------------------
# IMPORTANT: To use Gmail SMTP, you MUST:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an "App Password" (select "Mail" and "Other")
# 4. Use the 16-character password (without spaces) as SMTP_PASSWORD
#
# Example values:
# SMTP_USER=111harisawan@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop  <-- Remove spaces: abcdefghijklmnop
# SMTP_FROM_EMAIL=111harisawan@gmail.com

EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=111harisawan@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=111harisawan@gmail.com
SMTP_FROM_NAME=DoneKaro

# --------------------------------------------
# NOTIFICATION SETTINGS
# --------------------------------------------
# Hours before deadline to send reminder email
DEADLINE_REMINDER_HOURS=24
# Enable/disable the background scheduler
SCHEDULER_ENABLED=true
