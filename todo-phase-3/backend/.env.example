# Database connection (shared with Phase 2)
DATABASE_URL=postgresql://user:password@host:5432/database

# LLM Configuration
# Google Gemini API key (primary - free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API key (optional fallback)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Model selection (default: gemini/gemini-2.5-flash)
# Options: gemini/gemini-2.5-flash, gemini/gemini-2.5-flash-lite, gpt-4o-mini, gpt-4o
LLM_MODEL=gemini/gemini-2.5-flash
